{
  "name": "@bounded-systems/drift-gate",
  "version": "0.3.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "ts-morph": "npm:ts-morph@^28",
    "verbspec": "jsr:@bounded-systems/verbspec@^0.3.1",
    "zod": "npm:zod@^4.4.3",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "check": "deno check mod.ts cli.ts",
    "test": "deno test -A",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "drift": "deno run --allow-read --allow-write --allow-env --allow-sys cli.ts",
    "compile": "deno compile --allow-read --allow-write --allow-env --allow-sys --output dist/drift cli.ts"
  },
  "fmt": {
    "include": [
      "src/",
      "mod.ts",
      "cli.ts",
      "release_workflow_test.ts"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "mod.ts",
      "cli.ts",
      "release_workflow_test.ts"
    ]
  },
  "publish": {
    "include": [
      "mod.ts",
      "cli.ts",
      "src/",
      "LICENSE",
      "README.md",
      "deno.json"
    ],
    "exclude": [
      "**/*_test.ts"
    ]
  }
}
